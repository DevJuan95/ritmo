{
  "name": "ritmo",
  "version": "0.1.0",
  "private": true,
  "description": "Pomodoro, tareas diarias y bloqueo de distracciones para macOS",
  "main": "dist/src/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && tsc && tsc -p tsconfig.renderer.json --noEmit && esbuild src/renderer/app.ts --bundle --platform=browser --format=iife --outfile=dist/src/renderer.js && cp src/index.html src/block-sites.sh assets/icon.png dist/src/ && npm run build:css",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/src/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./dist/src/styles.css --watch",
    "start": "npm run build && electron .",
    "test": "npm run build && npm run test:all",
    "test:all": "node --test \"dist/test/**/*.test.js\"",
    "test:unit": "tsc && node --test \"dist/test/unit/**/*.test.js\"",
    "test:contract": "tsc && node --test \"dist/test/contract/**/*.test.js\"",
    "test:integration": "tsc && node --test \"dist/test/integration/**/*.test.js\"",
    "coverage": "npm run build && c8 npm run test:all",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.0.0",
    "c8": "^12.0.0",
    "daisyui": "^5.7.46",
    "electron": "^44.4.5",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "awilix": "^13.0.5"
  }
}
